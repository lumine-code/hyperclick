{
  "name": "hyperclick",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Follow the symbol under the pointer to its definition with a click.",
  "keywords": [
    "go-to-definition",
    "declaration",
    "navigation",
    "alt-click",
    "underline"
  ],
  "repository": "https://github.com/lumine-code/hyperclick",
  "bugs": {
    "url": "https://github.com/lumine-code/hyperclick/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "hoverDelay": {
      "title": "Hover Delay",
      "description": "How long the pointer must rest on a symbol while Alt is held, in milliseconds, before its providers are asked about it. Pressing Alt checks immediately; higher values ask less often while the pointer is travelling.",
      "type": "integer",
      "minimum": 0,
      "default": 100
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "hyperclick.provider": {
      "description": "Turns a word in the editor into something clickable.",
      "versions": {
        "^1.0.0": "consumeHyperclick"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
